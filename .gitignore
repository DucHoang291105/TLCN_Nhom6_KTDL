# Local data - không commit dữ liệu lớn
data/incoming/**
!data/incoming/**/.gitkeep
!data/incoming/**/README.md
# Snapshot batches: every source, every YYYYMMDD batch, only <source>_raw.csv
# (CSV goes through Git LFS, see .gitattributes). Temporary crawl folders such
# as 20261003_150728/ do not match and stay local.
!data/incoming/snapshots/
!data/incoming/snapshots/*/
!data/incoming/snapshots/*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
!data/incoming/snapshots/*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/*_raw.csv

